# Copy this file to .env before running the API. The test suite does not use it:
# it has its own committed environment, .env.test, so `yarn test` needs no setup.

# The key /sign and /verify derive their HMAC signatures from. It has no default:
# the process refuses to start without it. Use a long random value per
# environment, for instance `openssl rand -hex 32`, and keep it out of git.
SIGNING_SECRET=dev-only-secret-do-not-use-in-production

# The port the server listens on. Optional, unlike the secret: it defaults to 3000
# and is only set by an environment that has another opinion, such as a platform
# that injects one.
# PORT=3000
